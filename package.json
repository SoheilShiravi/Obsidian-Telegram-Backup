{
	"name": "obsidian-telegram-backup",
	"version": "1.0.0",
	"description": "Back up notes, folders and the whole vault to a Telegram channel or chat with your own bot.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node test/run-tests.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"telegram",
		"backup"
	],
	"author": "SoheilShiravi",
	"repository": {
		"type": "git",
		"url": "https://github.com/SoheilShiravi/obsidian-telegram-backup.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2"
	},
	"dependencies": {
		"fflate": "^0.8.3"
	}
}
